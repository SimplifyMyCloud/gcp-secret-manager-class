# ─────────────────────────────────────────────────────────────────────────────
#  W O P R   ·   green-phosphor CRT profile for Ghostty
#  For the GCP Secret Manager / WarGames classroom demo.
#
#  NOTE: Ghostty does NOT support trailing/inline comments — every comment must
#  be on its own line. Keep it that way or startup will error.
#  Install: see ghostty/README.md (copy this + wopr-crt.glsl to ~/.config/ghostty/)
# ─────────────────────────────────────────────────────────────────────────────

# ── Font (blocky / old-school) ──
# Easiest install:  brew install --cask font-3270-nerd-font
# For extra DOS authenticity add "Px437 IBM VGA8" (int10h.org oldschool pack).
# Verify the family name:  ghostty +list-fonts | grep -iE '3270|VGA'
font-family = "3270 Nerd Font"
font-family = "Px437 IBM VGA8"
font-family = "Menlo"
# Big-screen friendly. Bump to 22-24 for a large room.
font-size = 24
# macOS: fatten the strokes for a blockier look
font-thicken = true
# A touch of extra line height for that scanline-gap feel
adjust-cell-height = 8%

# ── Colors: monochrome phosphor green ──
# Everything renders as brightness levels of green, like a single-gun P1 tube.
# Want amber instead? See ghostty/README.md.
background = #001100
foreground = #33ff33
cursor-color = #33ff33
cursor-text = #001100
selection-background = #33ff33
selection-foreground = #001100
palette = 0=#001100
palette = 1=#009900
palette = 2=#00cc00
palette = 3=#33dd33
palette = 4=#00aa22
palette = 5=#22bb22
palette = 6=#33cc44
palette = 7=#66ff66
palette = 8=#114411
palette = 9=#00cc00
palette = 10=#33ff33
palette = 11=#66ff66
palette = 12=#22cc33
palette = 13=#44dd44
palette = 14=#55ee55
palette = 15=#ccffcc

# ── Cursor ──
cursor-style = block
cursor-style-blink = true

# ── CRT shader (scanlines + glow + curvature) ──
# Static (no strobe) — projector- and photosensitivity-safe.
# Comment this line out if text clips at the corners on a projector.
custom-shader = wopr-crt.glsl
custom-shader-animation = false

# ── Window / immersion ──
# Always open at the config font-size above — don't inherit a previous window's
# size or restore a manual Cmd+ zoom from last session.
window-inherit-font-size = false
window-save-state = never
# CRT wants full opacity for contrast.
background-opacity = 1.0
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
mouse-hide-while-typing = true
bold-is-bright = true
# Full immersion; set to "native" to get the title bar back.
macos-titlebar-style = hidden
